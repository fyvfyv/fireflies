# Copy to .env.local (or run `vercel env pull .env.local`, which writes that file).
# server/loadEnv.ts reads .env.local first, then .env.

# Neon Postgres, injected by the Vercel Marketplace integration.
# drizzle uses DATABASE_URL at runtime (neon-http) and DATABASE_URL_UNPOOLED for migrations
# (falling back to DATABASE_URL when it is empty).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Private Vercel Blob store; required by handleUpload to mint client upload tokens.
BLOB_READ_WRITE_TOKEN=

# Vercel AI Gateway key for local runs; on Vercel, OIDC authenticates automatically.
# Locally the VERCEL_OIDC_TOKEN written by `vercel env pull` also works until it expires.
AI_GATEWAY_API_KEY=

# Speech-to-text provider: `gateway` (AI Gateway transcription beta) or `groq`.
STT_PROVIDER=gateway
# Gateway transcription model, used when STT_PROVIDER=gateway.
STT_MODEL=openai/whisper-1
# Only needed when STT_PROVIDER=groq (free key at console.groq.com).
GROQ_API_KEY=

# Summary model routed through AI Gateway, plus comma-separated gateway fallbacks.
LLM_MODEL=anthropic/claude-haiku-4.5
LLM_FALLBACK_MODELS=google/gemini-2.5-flash

# Optional, dev only: enables the drizzleRepo contract tests against a throwaway, migrated
# database (the suite deletes every meeting). Vitest doesn't read this file, so pass it on the
# command line instead: TEST_DATABASE_URL=postgres://... pnpm test
TEST_DATABASE_URL=
