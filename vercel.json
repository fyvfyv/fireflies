{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm typecheck && pnpm build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
